# =============================================================================
# LLM-AnDPro — central path / environment configuration
#
# Sourced at the top of scripts/*.sh and experiments/*/run.sh. Centralizes all
# machine-specific paths in ONE place: the (uv) virtual-env, scratch cache/tmp
# dirs, Hugging Face caches, repo/log locations, and model/dataset paths.
#
# Convention: a variable with two candidate values keeps the ACTIVE value
# uncommented and the ALTERNATIVE (usually a local directory) commented out just
# below it — flip the comment to switch. Every value uses ${VAR:-...} so an
# explicit override still wins, e.g. `MODEL_PATH=/x bash scripts/run_h100.sh`.
# =============================================================================

# --- Virtual environment (uv / venv) activation root -------------------------
# Active: H100 + figures venv.  Alternative (commented): A100 venv.
export VENV_PATH="${VENV_PATH:-/scratch/ahsan/venvs/kv44}"
# export VENV_PATH="${VENV_PATH:-/scratch/$USER/venvs/crisp_310}"

# --- Repository checkout (optional; auto-detected from script dir when unset) -
# export REPO_DIR="${REPO_DIR:-/scratch/$USER/LLM-AnDPro}"

# --- Log directory (note: #SBATCH --output/--error dirs are set separately) ---
export LOG_DIR="${LOG_DIR:-/home/ahsan/LLM-AnDPro/logs}"

# --- Scratch cache / tmp dirs (never write under $HOME) -----------------------
export TMPDIR="${TMPDIR:-/scratch/$USER/tmp}"
export PIP_CACHE_DIR="${PIP_CACHE_DIR:-/scratch/$USER/pip_cache}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-/scratch/$USER/.cache}"
export TORCH_EXTENSIONS_DIR="${TORCH_EXTENSIONS_DIR:-/scratch/$USER/torch_extensions}"
export CUDA_CACHE_PATH="${CUDA_CACHE_PATH:-/scratch/$USER/.nv/ComputeCache}"

# --- Hugging Face caches ------------------------------------------------------
export HF_HOME="${HF_HOME:-/scratch/$USER/hf_cache}"
export TRANSFORMERS_CACHE="${TRANSFORMERS_CACHE:-$HF_HOME}"
export HF_DATASETS_CACHE="${HF_DATASETS_CACHE:-$HF_HOME}"
export HF_HUB_CACHE="${HF_HUB_CACHE:-$HF_HOME/hub}"

# --- Matplotlib cache ---------------------------------------------------------
export MPLCONFIGDIR="${MPLCONFIGDIR:-/scratch/$USER/.cache/matplotlib}"

# --- Model path ---------------------------------------------------------------
# Active: Hugging Face Hub id.  Alternative (commented): local model directory.
export MODEL_PATH="${MODEL_PATH:-mistralai/Mistral-7B-Instruct-v0.2}"
# export MODEL_PATH="${MODEL_PATH:-/scratch/$USER/models/Mistral-7B-Instruct-v0.2}"

# --- Dataset path (per benchmark) --------------------------------------------
# Left fully commented so experiments/<EXPERIMENT>/run.sh keeps its own default.
# Uncomment ONE line for the benchmark you are running (Hub id active, local dir
# alternative below it).
# LongBench:
# export DATASET_PATH="${DATASET_PATH:-THUDM/LongBench}"
# export DATASET_PATH="${DATASET_PATH:-/scratch/$USER/datasets/LongBench}"
# RULER:
# export DATASET_PATH="${DATASET_PATH:-simonjegou/ruler}"
# export DATASET_PATH="${DATASET_PATH:-/scratch/$USER/datasets/ruler}"
